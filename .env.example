# Razorpay (test or live keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Admin dashboard login (server-side only)
ADMIN_EMAIL=admin@vkstudio.com
ADMIN_PASSWORD=admin123

# MySQL — docker-compose uses vk_app / vk_studio (see docker-compose.yml)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=vk_app
DATABASE_PASSWORD=vk_app_pass
DATABASE_NAME=vk_studio

# Auth0 — Regular Web Application (server-side session)
# https://manage.auth0.com → Applications → Settings
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_client_id
AUTH0_CLIENT_SECRET=your_client_secret
# openssl rand -hex 32
AUTH0_SECRET=your_64_char_hex_secret

# Google social login (Auth0 connection name — usually google-oauth2)
# AUTH0_GOOGLE_CONNECTION=google-oauth2

# Auth0 logout — add to Dashboard → Applications → rachel → Settings
# Allowed Logout URLs: http://localhost:3000/login
# (and your production URL/login when you deploy)

# Instagram reels — paste reel links in src/lib/site-data.ts → instagramReels
# Get link: Instagram app → Reel → Share → Copy link
# Example: https://www.instagram.com/reel/AbCdEfGhIjK/
# View counts are fetched automatically from Instagram embed pages (cached 1 hour).
# To set manually, add views: 12000 on a reel entry in site-data.ts

# Optional: expose key id to client if needed (server uses RAZORPAY_KEY_ID)
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
