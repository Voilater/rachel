# Razorpay (test or live keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Public key only (safe for Vite client bundle)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Admin dashboard login (server-side only — never shown in the UI)
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# MySQL — local Homebrew MySQL only (not Docker)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=admin
DATABASE_PASSWORD=admin
DATABASE_NAME=vk_studio
DATABASE_ROOT_USER=admin
DATABASE_ROOT_PASSWORD=admin

# App URL (used for OAuth redirects, SEO canonical/OG, sitemap)
APP_BASE_URL=http://localhost:3000
# Optional client mirror for absolute URLs in the browser
VITE_APP_BASE_URL=http://localhost:3000

# Amazon Cognito
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=your-domain.auth.ap-south-1.amazoncognito.com
AUTH_COGNITO_ID=
AUTH_COGNITO_SECRET=
AUTH_COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/your_pool_id

# Google OAuth (normal Google button — not Cognito Hosted UI)
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth.js
# openssl rand -hex 32
AUTH_SECRET=your_64_char_hex_secret
AUTH_URL=http://localhost:3000/api/auth
AUTH_TRUST_HOST=true

# Email/password signup & login → Cognito (your branded /login UI, no Hosted UI).
# Google button → Google consent screen directly.
# Products / cart / orders stay in MySQL.

# Instagram reels — paste reel links in src/lib/site-data.ts → instagramReels
# Get link: Instagram app → Reel → Share → Copy link
# Example: https://www.instagram.com/reel/AbCdEfGhIjK/
# View counts are fetched automatically from Instagram embed pages (cached 1 hour).
# To set manually, add views: 12000 on a reel entry in site-data.ts

# Gmail SMTP — order status emails (processing / shipped / delivered / cancelled)
# 1) Google Account → Security → 2-Step Verification (ON)
# 2) App passwords → Mail → copy 16-char password into SMTP_PASS
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=your.gmail@gmail.com
SMTP_FROM_NAME=Rachel Paradise

